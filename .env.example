APP_ENV=development
APP_NAME=Beyond Fire Radar
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/beyond_fire_radar.db
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_HOURS=8
ENABLE_LIVE_SARASOTA_DISPATCH_POLLING=false
ENABLE_SARASOTA_POLLING_WORKER=false
ENABLE_SYNTHETIC_FIXTURE_PROVIDERS=false
SARASOTA_DISPATCH_URL=https://dispatchreporting.scgov.net/Events?strAgencyID=All
SARASOTA_POLL_INTERVAL_SECONDS=900
SARASOTA_POLL_TIMEOUT_SECONDS=20
SARASOTA_LIVE_AUTHORIZATION_BASIS=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-in-development
ENABLE_BOOTSTRAP=true
WEB_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=*
RAW_SNAPSHOT_DIR=data/raw-snapshots
ENABLE_LEARNED_MODEL_SERVING=false
MAX_PROPERTY_IMPORT_BYTES=25000000
MAX_CLIENT_IMPORT_BYTES=5000000
MAX_REQUEST_BYTES=30000000
MAX_ARCHIVE_MEMBERS=100
MAX_ARCHIVE_UNCOMPRESSED_BYTES=100000000
SESSION_IDLE_TTL_HOURS=8
MAX_ACTIVE_SESSIONS=5
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_UPLOAD_REQUESTS=20
REDIS_REQUIRED_FOR_READINESS=false
RAW_SNAPSHOT_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=beyond-fire-radar/raw-snapshots
RAW_SNAPSHOT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=2555
AUDIT_CHAIN_ENABLED=true
LOG_LEVEL=INFO
ERROR_TRACKING_DSN=
ENABLE_API_DOCS=true
